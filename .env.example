# Server-side only — never commit real keys.
# Rotate any keys that were pasted in chat.

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Prefer IAM role / Bedrock API key via Mantle in production — not long-lived keys in the browser.

BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0

# Optional: shared secret for signup webhook
PAL_WEBHOOK_SECRET=
