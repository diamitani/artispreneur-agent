# Server-side only — never commit real keys.
# Rotate any keys that were pasted in chat.

APP_URL=http://localhost:3000

# ── AWS Cognito OAuth (product login) ──────────────────────────
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
# AUTH_DEV_BYPASS=1

# ── Amazon Bedrock — Hermes Agent LLM (DeepSeek) ───────────────
# Platform credentials (server only). Do NOT give these to customers.
AWS_REGION=us-east-1
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=deepseek.v3-v1:0
# Preferred: Bedrock API key (bearer)
AWS_BEARER_TOKEN_BEDROCK=
# Or SigV4:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ── AWS Instance System (hub + control plane) ──────────────────
# See docs/AWS_INSTANCE.md
# fs = local .data (default) · s3 = durable Rostr Hub
HUB_BACKEND=fs
# HUB_BACKEND=s3
# S3_HUB_BUCKET=artispreneur-agent-hub
# DYNAMODB_INSTANCE_TABLE=artispreneur-agent-instances
# AWS_HUB_REGION=us-east-1

# ── Customer workspace Agent keys ──────────────────────────────
# Issued automatically per workspace as apa_live_|apa_test_|{96 hex}
# Auth: Authorization: Bearer apa_…  or  X-Artispreneur-Agent-Key: apa_…
# These track usage separately from AWS platform credentials.
# Stored hashed under hub 00-config/api-keys.json + KEY# index

PAL_WEBHOOK_SECRET=

# ── Skills Marketplace ─────────────────────────────────────────
# All catalog prices are $0 while SKILLS_FORCE_FREE is not "0"
SKILLS_FORCE_FREE=1
# Optional: use Stripe Checkout even for $0 (collects email / payment method)
# SKILLS_STRIPE_FREE_CHECKOUT=1

# Stripe (Checkout + webhook)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Composio (Gmail, Drive, Sheets, Calendar, Slack, 200+ integrations) ─
# Get your API key at https://app.composio.dev
COMPOSIO_API_KEY=

# HubSpot CRM tracking (views / adds / purchases)
HUBSPOT_ACCESS_TOKEN=

