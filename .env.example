# Artispreneur Agent v3 — Environment Variables

# ── AWS Cognito OAuth ──
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=your-domain.auth.us-east-1.amazoncognito.com
COGNITO_REDIRECT_URI=http://localhost:3000/api/auth/callback
COGNITO_LOGOUT_URI=http://localhost:3000/

# ── AWS Services ──
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Bedrock LLM ──
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

# ── Bedrock Agent (per-workspace, provisioned dynamically) ──
# BEDROCK_AGENT_ID=
# BEDROCK_AGENT_ALIAS_ID=

# ── Hub Storage ──
HUB_BACKEND=fs
# S3_HUB_BUCKET=artispreneur-agent-hub

# ── Stripe ──
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Session ──
SESSION_SECRET=change-me-to-a-random-32-char-string

# ── DynamoDB ──
DYNAMODB_TABLE=artispreneur-agent-v3

# ── Dev ──
AUTH_DEV_BYPASS=1

# ── App ──
APP_URL=http://localhost:3000
NODE_ENV=development
