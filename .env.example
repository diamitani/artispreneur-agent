# Artispreneur Agent v3 — Environment Variables

# ── AWS Cognito OAuth ──
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=your-domain.auth.us-east-1.amazoncognito.com
COGNITO_REDIRECT_URI=http://localhost:3000/api/auth/callback
COGNITO_LOGOUT_URI=http://localhost:3000/
# Only if the app client was created WITH a secret. A public web client has none.
COGNITO_CLIENT_SECRET=
# The user pool app client must have USER_PASSWORD_AUTH enabled for the
# branded sign-in pages (ALLOW_USER_PASSWORD_AUTH on the client).

# ── AWS Services ──
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Bedrock LLM ──
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

# ── Bedrock Agent (per-workspace, provisioned dynamically) ──
# BEDROCK_AGENT_ID=
# BEDROCK_AGENT_ALIAS_ID=

# ── Hub Storage ──
HUB_BACKEND=fs
# S3_HUB_BUCKET=artispreneur-agent-hub

# ── Stripe ──
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Session ──
SESSION_SECRET=change-me-to-a-random-32-char-string

# ── DynamoDB ──
DYNAMODB_TABLE=artispreneur-agent-v3

# ── Dev ──
AUTH_DEV_BYPASS=1

# ── App ──
APP_URL=http://localhost:3000
NODE_ENV=development

# ── Integrations ──
# Composio (mainstream OAuth apps: Gmail, Drive, Sheets, Calendar, HubSpot, Notion, Slack)
COMPOSIO_API_KEY=

# Music MCP server (/api/mcp/music)
# MusicBrainz needs no credentials; set a contact UA per their policy.
MUSICBRAINZ_USER_AGENT=ArtispreneurAgent/1.0 ( you@example.com )
# Spotify Web API — client credentials (app-level, not per-artist)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
