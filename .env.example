# Artispreneur Agent — Environment Variables
# Copy to .env.local for development, or set in your deploy platform (Vercel, etc.)

# ── AWS Cognito OAuth (Required for auth) ──
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=your-domain.auth.us-east-1.amazoncognito.com
COGNITO_REDIRECT_URI=http://localhost:3000/api/auth/callback
COGNITO_LOGOUT_URI=http://localhost:3000/

# ── AWS Services ──
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bedrock LLM
BEDROCK_MODEL_ID=deepseek.v3-v1:0

# ── Hub Storage ──
# Local dev (default)
HUB_BACKEND=fs

# Production — flip to S3
# HUB_BACKEND=s3
# S3_HUB_BUCKET=artispreneur-agent-hub
# DYNAMODB_INSTANCE_TABLE=artispreneur-agent-instances

# ── Stripe (Skills Marketplace checkout) ──
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── HubSpot ──
HUBSPOT_API_KEY=

# ── Dev bypass (NEVER in production) ──
# AUTH_DEV_BYPASS=1

# ── App ──
APP_URL=http://localhost:3000
NODE_ENV=development
